# API key for Neynar (used for Farcaster API requests)
NEYNAR_API_KEY=your-neynar-api-key-here

# Farcaster signer UUIDs (from Neynar)
FARCASTER_SIGNER_UUID=your-farcaster-signer-uuid-here
FARCASTER_QRBIDS_SIGNER_UUID=your-farcaster-qrbids-signer-uuid-here

# RPC URL for Base (8453) — typically from providers like Alchemy
PONDER_RPC_URL_8453=your-rpc-url

# X (Twitter) App credentials — consumer key/secret from developer.x.com
# App must be attached to a Project in the developer portal
# Account uses pay-per-use credits model (402 = credits depleted)
X_APP_KEY=your-consumer-key-here
X_APP_SECRET=your-consumer-secret-here

# X (Twitter) user access tokens (OAuth 1.0a — required for posting)
TWITTER_ACCESS_TOKEN_KEY=your-access-token-key-here
TWITTER_ACCESS_TOKEN_SECRET=your-access-token-secret-here

# X (Twitter) bearer token (app-only auth — used for search/read)
TWITTER_BEARER_TOKEN=your-bearer-token-here

# OpenAI configuration (for AI-rewritten posts)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here
